{
  "name": "@unkindnesses/raven",
  "version": "0.5.1",
  "type": "module",
  "files": [
    "common",
    "src",
    "dist"
  ],
  "bin": {
    "raven": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prepack": "npm run build",
    "build:cli": "esbuild --platform=node --sourcemap --bundle --format=esm --external:commander --external:vscode-languageserver --external:vscode-languageserver/* --outdir=dist/cli src/cli/index.ts src/cli/worker.ts src/cli/exec.ts src/cli/lib.ts",
    "watch": "npm run build:cli -- --watch",
    "start": "npm run build:cli && node --enable-source-maps dist/cli/index.js",
    "build": "node scripts/bundle-common.js && tsc -b && npm run build:cli",
    "test": "npm run build && node --max-old-space-size=8192 --enable-source-maps ./node_modules/vitest/vitest.mjs run"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "playwright": "^1.61.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "vscode-languageserver": "^10.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
