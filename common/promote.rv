export { coerce, promote }

Integer = tag".Integer"
Real = tag".Real"
Number = tag".Number"

fn coerce(a: Number, b: Number) { nil }

fn promote(a: Number, b: Number) {
  if let [a, b] = coerce(a, b) { return [a, b] }
  if let [b, a] = coerce(b, a) { return [a, b] }
}

fn (a: Number) + (b: Number) {
  if tag(a) == tag(b) { abort("+ not defined for this type") }
  [a, b] = promote(a, b)
  return a + b
}

fn (a: Number) - (b: Number) {
  if tag(a) == tag(b) { abort("- not defined for this type") }
  [a, b] = promote(a, b)
  return a - b
}

fn (a: Number) * (b: Number) {
  if tag(a) == tag(b) { abort("* not defined for this type") }
  [a, b] = promote(a, b)
  return a * b
}

fn (a: Number) / (b: Number) {
  if tag(a) == tag(b) { abort("/ not defined for this type") }
  [a, b] = promote(a, b)
  return a / b
}

fn (a: Number) ^ (b: Number) {
  if tag(a) == tag(b) { abort("^ not defined for this type") }
  [a, b] = promote(a, b)
  return a ^ b
}

fn (a: Real) > (b: Real) {
  if tag(a) == tag(b) { abort("> not defined for this type") }
  [a, b] = promote(a, b)
  return a > b
}

fn (a: Real) < (b: Real) {
  if tag(a) == tag(b) { abort("< not defined for this type") }
  [a, b] = promote(a, b)
  return a < b
}

fn (a: Real) >= (b: Real) {
  if tag(a) == tag(b) { abort(">= not defined for this type") }
  [a, b] = promote(a, b)
  return a >= b
}

fn (a: Real) <= (b: Real) {
  if tag(a) == tag(b) { abort("<= not defined for this type") }
  [a, b] = promote(a, b)
  return a <= b
}

fn min(a: Real, b: Real) {
  if tag(a) == tag(b) {
    [a, b] = promote(a, b)
    if a < b { a } else { b }
  } else {
    [a, b] = promote(a, b)
    return min(a, b)
  }
}

fn max(a: Real, b: Real) {
  if tag(a) == tag(b) {
    [a, b] = promote(a, b)
    if a > b { a } else { b }
  } else {
    [a, b] = promote(a, b)
    return max(a, b)
  }
}
