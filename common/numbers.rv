export {
  Integer, Real, Number, BigInt, Float32, Float64, Complex, real, imag
  ==, !=, !, +, -, *, /, ^, >, <, >=, <=, &, |, abs2, conj, div, rem
  zero?, zero, one, round, min, max, factorial
}

fn matchTrait(tag".Real", x: (Float32 | Float64)) { Some(x) }
fn matchTrait(tag".Integer", x: (Int | UInt | BigInt)) { Some(x) }

fn matchTrait(tag".Real", x: Integer) { Some(x) }
fn matchTrait(tag".Number", x: Real) { Some(x) }

fn coerce(a: Float64, b: Integer) { [a, Float64(b)] }

include "numbers/complex.rv"

fn (x: Integer) ^ (n: Integer) {
  r = one(x)
  while n > 0 {
    n = n - one(n)
    r = r * x
  }
  return r
}

fn factorial(n: Integer) {
  if n < zero(n) { abort("factorial requires a non-negative integer") }
  r = one(n)
  while n > zero(n) {
    r = r * n
    n = n - one(n)
  }
  return r
}

fn show(x: Bits) {
  print(`bits"`)
  N = bitsize(x)
  for i = range(1, N) {
    print(Int64(bitand(bitshr_u(x, bitcast(x, bits(N - i))), bitcast(x, bits(1)))))
  }
  print(`"`)
}

fn print(x: (Float64 | Float32)) {
  print(string(x))
}

fn show(x: Float64) {
  print(x)
}

fn show(x: Float32) {
  print("Float32(")
  print(x)
  print(")")
}
