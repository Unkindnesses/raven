import { ... } from "./core.rv"
import { IndexIterator } from "./iterate.rv"

export { List, length, set, append, pop, empty? }

bundle List(xs...)

fn list(xs...) { List(xs...) }

@extend
fn length(xs: List) {
  nparts(xs)
}

fn (xs: List)[i] {
  part(xs, i)
}

# TODO fallback equality
@extend
fn (xs: List) == (ys: List) {
  if length(xs) != length(ys) { return false }
  for i = (1..length(xs)) {
    if xs[i] != ys[i] { return false }
  }
  return true
}

@extend
fn set(&xs: List, [i: Int64], x) {
  xs = tag"common.core/set"(xs, i, x)
}

@extend
fn empty?(xs: List) {
  length(xs) == 0
}

@extend
fn append(&xs: List, x) {
  xs = [xs..., x]
  return xs
}

fn pop(&xs: List) {
  last = xs[length(xs)]
  ys = []
  for i = (1..(length(xs) - 1)) { append(&ys, xs[i]) }
  xs = ys
  return last
}

@extend
fn iterate(xs: List) { IndexIterator(xs) }

@extend
fn rest(xs: List) {
  if empty?(xs) { abort("List is empty") }
  result = []
  for i = (2..length(xs)) {
    append(&result, xs[i])
  }
  return result
}

@extend
fn show(x: List) {
  print("[")
  for i = (1..nparts(x)) {
    if i != 1 {
      print(", ")
    }
    show(x[i])
    i = i + 1
  }
  print("]")
}

@extend
fn js(xs: List) {
  ys = js.Array.of()
  for x = xs { ys.push(x) }
  return ys
}
