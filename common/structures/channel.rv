export { RingBuffer, Channel, put!, take! }

bundle RingBuffer(data: Cell, state: Cell)

fn RingBuffer(T, cap: Int64) {
  if cap < 1 { abort("RingBuffer capacity must be positive") }
  state = Cell(Int64, 2)
  state[1] = 1
  state[2] = 0
  RingBuffer(Cell(T, cap), state)
}

fn length(buf: RingBuffer(data, state)) {
  state[2]
}

fn capacity(RingBuffer(data, _)) {
  length(data)
}

fn wrap(i: Int64, cap: Int64) {
  rem(i - 1, cap) + 1
}

fn slot(state: Cell, cap: Int64, i: Int64) {
  wrap(state[1] + i - 1, cap)
}

fn requireIndex(i: Int64, len: Int64) {
  if i < 1 || i > len {
    abort("RingBuffer index out of range")
  }
}

fn (buf: RingBuffer(data, state))[i] {
  requireIndex(i, state[2])
  data[slot(state, length(data), i)]
}

fn set(&buf: RingBuffer(data, state), [i: Int64], x) {
  requireIndex(i, state[2])
  data[slot(state, length(data), i)] = x
  buf = RingBuffer(data, state)
}

fn put!(&buf: RingBuffer(data, state), x) {
  n = state[2]
  if n == length(data) { abort("RingBuffer is full") }
  data[slot(state, length(data), n + 1)] = x
  state[2] = n + 1
  return buf
}

fn take!(&buf: RingBuffer(data, state)) {
  n = state[2]
  if n == 0 { abort("RingBuffer is empty") }
  x = data[state[1]]
  n = n - 1
  state[1] = wrap(state[1] + 1, length(data))
  state[2] = n
  return x
}

bundle Channel(buf: RingBuffer, readers: JSObject, writers: JSObject)

fn Channel(T, cap: Int64) {
  Channel(RingBuffer(T, cap), js([]), js([]))
}

fn notify(waiters: JSObject) {
  ```js
  while (\waiters.length !== 0) {
    const [future, index] = \waiters.shift()
    if (future.resolve(index)) break
  }
  ```
}

fn tryPut!(&ch: Channel(buf, readers, writers), x) {
  if length(buf) == capacity(buf) { return false }
  put!(buf, x)
  notify(readers)
  return true
}

fn put!(&ch: Channel(buf, readers, writers), x) {
  if tryPut!(ch, x) { return ch }
  future = JSFuture()
  writers.push([future, 0])
  await(future)
  return put!(ch, x)
}

fn tryTake!(&ch: Channel(buf, readers, writers)) {
  if length(buf) == 0 { return nil }
  x = take!(buf)
  notify(writers)
  return Some(x)
}

fn take!(&ch: Channel(buf, readers, writers)) {
  if let Some(x) = tryTake!(ch) { return x }
  future = JSFuture()
  readers.push([future, 0])
  await(future)
  return take!(ch)
}

fn selectPrepare($take!, future: JSFuture, i: Int64, Channel(buf, readers, _)) {
  if length(buf) != 0 {
    resolve!(future, i)
  } else {
    readers.push([future, i])
  }
  return
}

fn selectAccept($take!, &ch: Channel) {
  if let Some(x) = tryTake!(ch) { return x }
  abort("select take failed")
}

fn selectPrepare($put!, future: JSFuture, i: Int64, Channel(buf, _, writers), _) {
  if length(buf) != capacity(buf) {
    resolve!(future, i)
  } else {
    writers.push([future, i])
  }
  return
}

fn selectAccept($put!, &ch: Channel, x) {
  if !tryPut!(ch, x) { abort("select put failed") }
  return
}

fn selectPrepare($await, future: JSFuture, i: Int64, promise: JSObject) {
  promise.then(js`return () => \future.resolve(\i)`)
  return
}

fn selectAccept($await, promise: JSObject) {
  await(promise)
}

fn select(cases...) {
  future = JSFuture()
  for i = range(1, length(cases)) {
    [f, args] = cases[i]
    selectPrepare(f, future, i, args...)
  }
  index = await(future)
  Int64(index)
}
