fn matchTrait($Float32, x: pack($Float32, _)) { Some(x) }
fn matchTrait($Float64, x: pack($Float64, _)) { Some(x) }

@extend
fn Float32(x: Float64) {
  wasm f32.demote_f64(x: f64): f32
}

@extend
fn Float64(x: Float32) {
  wasm f64.promote_f32(x: f32): f64
}

fn one(x: Float64) { 1.0 }
fn zero(x: Float64) { 0.0 }

fn promote(x: Float64, y: Float64) { [x, y] }
fn promote(x: Float32, y: Float32) { [x, y] }

fn coerce(x: Float64, y: Float32) { [x, Float64(y)] }

fn (a: Float64) + (b: Float64) {
  wasm f64.add(a: f64, b: f64): f64
}

fn (-(x: Float64)) {
  wasm f64.neg(x: f64): f64
}

fn (a: Float64) - (b: Float64) {
  wasm f64.sub(a: f64, b: f64): f64
}

fn (a: Float64) * (b: Float64) {
  wasm f64.mul(a: f64, b: f64): f64
}

fn (a: Float64) / (b: Float64) {
  wasm f64.div(a: f64, b: f64): f64
}

fn (a: Float64) == (b: Float64) {
  Bool(wasm f64.eq(a: f64, b: f64): i32)
}

fn (a: Float64) > (b: Float64) {
  Bool(wasm f64.gt(a: f64, b: f64): i32)
}

fn (a: Float64) < (b: Float64) {
  Bool(wasm f64.lt(a: f64, b: f64): i32)
}

fn (a: Float32) == (b: Float32) {
  Bool(wasm f32.eq(a: f32, b: f32): i32)
}

fn abs(a: Float64) {
  wasm f64.abs(a: f64): f64
}

fn min(a: Float64, b: Float64) {
  wasm f64.min(a: f64, b: f64): f64
}

fn max(a: Float64, b: Float64) {
  wasm f64.max(a: f64, b: f64): f64
}

fn i64trunc(x: Float64) {
  Int64(wasm i64.trunc_f64_s(x: f64): i64)
}

fn round(x: Float64) {
  x = wasm f64.nearest(x: f64): f64
  return i64trunc(x)
}

fn integer?(x: Float64) {
  abs(x) == one(x) / zero(x) && return false
  x == wasm f64.floor(x: f64): f64
}

fn integer?(x: Float32) {
  integer?(Float64(x))
}

# libm

export {
  Inf, NaN, pi, sqrt, cbrt, hypot, exp, expm1, log, log1p, log2, log10, pow
  sin, cos, tan, asin, acos, atan, sinh, cosh, tanh, asinh, acosh, atanh
}

Inf = 1.0 / 0.0
NaN = 0.0 / 0.0
pi = 3.141592653589793

fn sqrt(x: Float64) { Float64(js.Math.sqrt(x)) }
fn cbrt(x: Float64) { Float64(js.Math.cbrt(x)) }
fn hypot(x: Float64, y: Float64) { Float64(js.Math.hypot(x, y)) }

fn exp(x: Float64) { Float64(js.Math.exp(x)) }
fn expm1(x: Float64) { Float64(js.Math.expm1(x)) }
fn log(x: Float64) { Float64(js.Math.log(x)) }
fn log1p(x: Float64) { Float64(js.Math.log1p(x)) }
fn log2(x: Float64) { Float64(js.Math.log2(x)) }
fn log10(x: Float64) { Float64(js.Math.log10(x)) }
fn pow(x: Float64, y: Float64) { Float64(js.Math.pow(x, y)) }

fn sin(x: Float64) { Float64(js.Math.sin(x)) }
fn cos(x: Float64) { Float64(js.Math.cos(x)) }
fn tan(x: Float64) { Float64(js.Math.tan(x)) }
fn asin(x: Float64) { Float64(js.Math.asin(x)) }
fn acos(x: Float64) { Float64(js.Math.acos(x)) }
fn atan(x: Float64) { Float64(js.Math.atan(x)) }
fn atan(y: Float64, x: Float64) { Float64(js.Math.atan2(y, x)) }

fn sinh(x: Float64) { Float64(js.Math.sinh(x)) }
fn cosh(x: Float64) { Float64(js.Math.cosh(x)) }
fn tanh(x: Float64) { Float64(js.Math.tanh(x)) }
fn asinh(x: Float64) { Float64(js.Math.asinh(x)) }
fn acosh(x: Float64) { Float64(js.Math.acosh(x)) }
fn atanh(x: Float64) { Float64(js.Math.atanh(x)) }
