import { ... } from "../core.rv"
import { matchTrait } from "../patterns.rv"
import { bits } from "../integer.rv"

export {
  Ptr, Function, Counted, addr, invoke
  memoryPages, memoryGrow!, i32load, i32store!
}

bundle Ptr(x: Int32)

fn Ptr(x: Int64) { Ptr(Int32(x)) }

fn addr(Ptr(x)) { Int32(x) }

@extend
fn show(x: Ptr) {
  print("Ptr@")
  print(addr(x))
}

@extend
fn (p: Ptr) + x {
  Ptr(addr(p) + Int32(x))
}

@extend
fn (p: Ptr) - x {
  Ptr(addr(p) - Int32(x))
}

@extend
fn (p: Ptr) == (q: Ptr) {
  addr(p) == addr(q)
}

fn memoryPages() {
  Int32(wasm memory.size(): i32)
}

fn memoryGrow!(n: Int32) {
  Int32(wasm memory.grow(bits(n): i32): i32)
}

fn i32load(p: Ptr) {
  a = addr(p)
  Int32(wasm i32.load(bits(a): i32): i32)
}

fn i32store!(p: Ptr, x: Int32) {
  a = addr(p)
  wasm i32.store(bits(a): i32, bits(x): i32)
}

# Function pointer

bundle Counted(x)

fn Function(f, I, O) {
  ptr = function(f, I, O)
  Function(ptr, I, O)
}

bundle Function(f: Func, I, O)

fn (f: Function)(xs...) {
  Function(f, I, O) = f
  invoke(f, I, O, xs...)
}
