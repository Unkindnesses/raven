import { ... } from "./core.rv"
import { ... } from "./bootstrap.rv"
import { record, upsertkey, getkey, merge } from "./record.rv"

export {
  Any, NotNil, Params, Pattern, Term
  match, matchTrait, castTrait, isa?
}

castTrait = tag"/castTrait"

fn matchTrait($Tag, t: pack($Tag, _)) { Some(t) }
fn matchTrait($Closure, x: pack($Closure, _)) { Some(x) }
fn matchTrait($Func, x: pack($Func, _)) { Some(x) }

Any = tag"/Any"

fn matchTrait($Any, x) { Some(x) }

NotNil = tag"/NotNil"

fn matchTrait($NotNil, x) {
  if !nil?(x) { Some(notnil(x)) }
}

bundle Params(T, Ts)

@extend
fn show(pack($Params, T, Ts...)) {
  show(T)
  show(Ts)
}

bundle Term {
  Const(x)
  Var(name)
}

bundle Pattern {
  Hole()
  Literal(x)
  Trait(T, args...)
  Pack(xs...)
  Bind(name, pat)
  Constructor(name, args...)
  And(p, q)
}

fn constructorPattern($pack, args...) {
  Pack(args...)
}

fn resolve(env, pack($Const, T)) { T }
fn resolve(env, pack($Var, name)) { getkey(env, name) }

fn resolve(env, pack($Trait, T)) { resolve(env, T) }
fn resolve(env, pack($Trait, T, A)) { get(resolve(env, T), [resolve(env, A)]) }

# TODO unify env and bindings
fn scope(env, bs) {
  merged = merge(env, bs)
  if nil?(merged) { env } else { notnil(merged) }
}

fn _match(env, val, pack($Hole), deep) {
  return [val, record()]
}

fn _match(env, val, pack($Literal, pat), deep) {
  (val == pat) || return
  return [pat, record()]
}

fn _match(env, val, p: Trait, deep) {
  T = resolve(env, p)
  m = if deep { castTrait(T, val) } else { matchTrait(T, val) }
  nil?(m) && return
  return [part(notnil(m), 1), record()]
}

fn _match(env, val, pack($Bind, name, p), deep) {
  m = _match(env, val, p, deep)
  nil?(m) && return
  m = notnil(m)
  val = part(m, 1)
  bs = part(m, 2)
  upsertkey(&bs, name, val)
  return [val, bs]
}

fn _match(env, xs, p: Pack, deep) {
  eq(nparts(xs), nparts(p) - 1) || return
  m = _match(env, tag(xs), part(p, 1), deep)
  nil?(m) && return
  m = notnil(m)
  tag = part(m, 1)
  xs = tagcast(xs, tag)
  result = [pack(tag), part(m, 2)]
  i = 1
  while i < nparts(p) {
    if !nil?(result) {
      r = notnil(result)
      m = _match(scope(env, part(r, 2)), part(xs, i), part(p, i + 1), deep)
      if nil?(m) {
        result = nil
      } else {
        m = notnil(m)
        bs = merge(part(r, 2), part(m, 2))
        if nil?(bs) {
          result = nil
        } else {
          result = [packcat(part(r, 1), [part(m, 1)]), notnil(bs)]
        }
      }
    } else {
      # if the above is certain to fail, make sure the whole match is
      result = nil
    }
    i = i + 1
  }
  return result
}

fn _match(env, val, pack($Constructor, name, args...), deep) {
  _match(env, val, constructorPattern(name, args...), deep)
}

fn _match(val, pat, deep) { _match(record(), val, pat, deep) }

fn match(val, pat) {
  result = _match(val, pat, false)
  nil?(result) && return
  return part(notnil(result), 2)
}

fn isa?(val, T) {
  !nil?(matchTrait(T, val))
}
