import { ... } from "./core.rv"
import { map } from "./iterate.rv"
import { String } from "./strings.rv"
import { await, import } from "./wasm/js.rv"

export { args, readFile }

fn args() {
  return map(js.process.argv, String)
}

fn readFile(f: String) {
  fs = import("fs/promises")
  return String(await(fs.readFile(f, "utf8")))
}
