export { eq, !=, !, +, -, *, /, ^, >, <, >=, <=, &, | }

# These operators aren't overloaded, so we can use them to bootstrap matching.

eq = tag".eq"
!= = tag".!="
! = tag".!"
+ = tag".+"
- = tag".-"
* = tag".*"
/ = tag"./"
^ = tag".^"
> = tag".>"
< = tag".<"
>= = tag".>="
<= = tag".<="
& = tag".&"
| = tag".|"
|> = tag".|>"
